# faceid-react demo configuration. Copy to .env and adjust; rebuild after changes.
# Values in brackets are the defaults used when a variable is missing.
# Everything here is compiled into the public JavaScript bundle.

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of faceid-api. Use /api when served through vite (dev/preview proxy or the
# Cloudflare tunnel); use the full URL (e.g. http://localhost:8000) to call it directly.
VITE_API_URL=/api

# Must equal API_KEY in the backend .env. It is visible to anyone who opens the site.
VITE_API_KEY=your-api-key

# ── MediaPipe face detector (runs in the browser) ─────────────────────────────
# Where the detector runs: GPU or CPU [GPU].
VITE_MP_DELEGATE=GPU

# Minimum confidence (0–1) to report a face at all [0.5].
VITE_MP_MIN_DETECTION_CONFIDENCE=0.5

# Overlap (0–1) above which two detections are merged as the same face [0.3].
VITE_MP_MIN_SUPPRESSION_THRESHOLD=0.3

# short_range: faces within ~2 m, e.g. selfies/webcam; full_range: farther away [short_range].
VITE_MP_MODEL=short_range

# ── Auto-capture (when a frame is good enough to send) ────────────────────────
# How long the face must stay stable before the photo is taken, in ms [1500].
VITE_AUTO_CAPTURE_MS=2000

# JPEG quality (0–1) of the captured photo sent to the API [0.9].
VITE_CAPTURE_QUALITY=0.9

# Minimum detector confidence (0–1) for a frame to count as stable [0.85].
VITE_MIN_FRAME_CONFIDENCE=0.85

# Max nose movement between frames, as a fraction of the frame width [0.02].
# Lower = the person must hold stiller.
VITE_MAX_MOVEMENT=0.02

# Max head turn: nose offset from the eyes' midpoint relative to the eye distance [0.35].
# Lower = requires a more frontal face.
VITE_MAX_FACE_ASYMMETRY=0.35
