# faceid-api backend configuration. Copy to .env and adjust.
# Values in brackets are the defaults used when a variable is missing.

# ── Authentication ────────────────────────────────────────────────────────────
# Key required in the X-API-Key header of every endpoint except /health [changeme].
# The demo frontend embeds it (VITE_API_KEY), so treat it as public.
API_KEY=changeme

# Separate key for the backoffice endpoints (/admin/*, X-Admin-Key header) [empty].
# Empty disables them (503). Never put this one in the frontend .env.
ADMIN_API_KEY=

# ── Recognition ───────────────────────────────────────────────────────────────
# Face recognition model that produces the embedding [VGG-Face].
# Options: VGG-Face, Facenet, Facenet512, ArcFace, SFace, GhostFaceNet, Buffalo_L,
#          Dlib, OpenFace, DeepID, DeepFace.
# Changing it invalidates stored embeddings: re-register everyone (scripts/seed_lfw.py).
MODEL_NAME=Facenet512

# Face detector run before recognition/analysis [opencv].
# Options: opencv, mtcnn, retinaface, yolov8, yunet, centerface, mediapipe, ssd, dlib, fastmtcnn.
# opencv is fast but has false positives; retinaface is the most accurate but needs a GPU
# (~0.2 s/photo on GPU vs ~18 s on an old CPU); mtcnn is a CPU-friendly middle ground.
DETECTOR_BACKEND=opencv

# How two embeddings are compared [cosine]. Options: cosine, euclidean, euclidean_l2.
DISTANCE_METRIC=cosine

# Max distance to accept a match in /identify and /verify, in DISTANCE_METRIC units [empty].
# Empty uses DeepFace's default per model (Facenet512 + cosine = 0.30, VGG-Face + cosine = 0.68).
# Higher recognizes more people but confuses more strangers. The backend logs the best
# distance of every /identify call ("identify best match") to help calibrate it.
MATCH_THRESHOLD=

# Liveness check that rejects photos of photos or screens [false].
# Requires `pip install torch`. When true, spoofs are rejected with HTTP 400.
ANTI_SPOOFING=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Folder where registered face images are copied [./face_db].
# (The SQLite database is always ./deepface.db.)
FACE_DB_PATH=./face_db

# ── Cache (not used yet) ──────────────────────────────────────────────────────
# Read by the settings but no endpoint uses the cache yet; changing them has no effect.
CACHE_TTL=300
CACHE_MAXSIZE=256
